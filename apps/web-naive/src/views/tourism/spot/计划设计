表设计
CREATE TABLE `travel_region_spot` (
  `id` bigint NOT NULL AUTO_INCREMENT COMMENT 'id',
  `gmt_create` datetime DEFAULT CURRENT_TIMESTAMP COMMENT '创建时间',
  `gmt_modified` datetime DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP COMMENT '更新时间',
  `delete_flag` tinyint(1) NOT NULL DEFAULT '0' COMMENT '删除标识1是0否',
  `adcode` bigint DEFAULT NULL COMMENT '市id',
  `pcode` bigint DEFAULT NULL COMMENT '省code',
  `town_code` bigint DEFAULT NULL COMMENT '城市id',
  `town_name` varchar(32) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci DEFAULT NULL COMMENT '城镇名',
  `sort_no` int DEFAULT '999' COMMENT '排序',
  `score` varchar(8) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci DEFAULT NULL COMMENT '评分',
  `spot_type` enum('FOOD','ACTIVITY','HOTEL','ATTRACTION') CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci DEFAULT NULL COMMENT '景点类型 FOOD ACTIVITY HOTEL ATTRACTION',
  `poi_id` varchar(32) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci DEFAULT NULL COMMENT 'poiid',
  `title` varchar(64) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci DEFAULT NULL COMMENT '标题',
  `address` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci DEFAULT NULL COMMENT '地址',
  `tel` varchar(32) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci DEFAULT NULL COMMENT '手机号',
  `category` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci DEFAULT NULL COMMENT '标签',
  `type` varchar(32) CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci DEFAULT NULL COMMENT 'POI类型',
  `location` json DEFAULT NULL COMMENT '位置信息',
  `ad_info` json DEFAULT NULL COMMENT '行政区划信息',
  `business_info` json DEFAULT NULL COMMENT '业务信息',
  `image_urls` json DEFAULT NULL COMMENT '图片列表',
  PRIMARY KEY (`id`) USING BTREE,
  UNIQUE KEY `unix_poiid` (`poi_id`) USING BTREE,
  KEY `idx_adcode_type_score` (`adcode`,`spot_type`,`score`) USING BTREE,
  KEY `idx_towncode_type` (`town_code`,`spot_type`) USING BTREE
) ENGINE=InnoDB AUTO_INCREMENT=1865411284552519707 DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci ROW_FORMAT=DYNAMIC COMMENT='区地点表';

